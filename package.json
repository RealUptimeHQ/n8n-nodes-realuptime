{
  "name": "n8n-nodes-realuptime",
  "version": "0.2.0",
  "description": "n8n nodes for RealUptime Monitoring: create and read uptime monitors, list incidents, start a workflow when a monitor goes down, and check whether a service is down.",
  "keywords": [
    "n8n-community-node-package",
    "realuptime",
    "uptime",
    "monitoring",
    "incidents",
    "heartbeat",
    "outages"
  ],
  "license": "MIT",
  "homepage": "https://github.com/RealUptimeHQ/n8n-nodes-realuptime#readme",
  "author": {
    "name": "RealUptime",
    "email": "support@realuptime.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealUptimeHQ/n8n-nodes-realuptime.git"
  },
  "bugs": {
    "url": "https://github.com/RealUptimeHQ/n8n-nodes-realuptime/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test test/*.test.mjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/RealUptimeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RealUptime/RealUptime.node.js",
      "dist/nodes/RealUptime/RealUptimeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.56.3",
    "eslint": "9.39.4",
    "n8n-workflow": "2.16.0",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
